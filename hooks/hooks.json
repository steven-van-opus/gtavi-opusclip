{
  "description": "Ask before anything spends OpusClip credits or publishes. The hosted OpusClip MCP server posts, schedules and shares the moment a tool is called.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*opusclip.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["-I", "${CLAUDE_PLUGIN_ROOT}/scripts/guard.py"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["-I", "${CLAUDE_PLUGIN_ROOT}/scripts/guard.py"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
